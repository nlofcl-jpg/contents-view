# Local development
NODE_ENV=development
PORT=3000

# Current server database fallback.
# Keep this empty while migrating to Supabase unless the existing MySQL flow is needed.
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret

# Supabase client configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_KAKAO_JAVASCRIPT_KEY=

# Supabase server-side configuration.
# Never expose the service role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 news media. These credentials are server-only (no VITE_ prefix).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_NEWS_BUCKET=contents-view
# Stable application origin for article image URLs and previews.
NEWS_MEDIA_SITE_ORIGIN=https://contents-view-chi.vercel.app

# Optional API key encryption secret for user-saved provider keys.
# Use a stable 32+ byte value in production.
API_KEY_ENCRYPTION_SECRET=replace-with-a-stable-secret

# Provider keys used by server or Supabase Edge Functions.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Server-only Gemini credentials for the administrator AI test (never use VITE_).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Secret bearer token used by the scheduled YouTube snapshot collector.
CRON_SECRET=
# Comma-separated ISO country codes collected every run.
YOUTUBE_RISING_REGIONS=KR,US,JP

# Legacy Manus OAuth values. Leave empty after Supabase Auth migration.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Legacy Manus Forge values. Leave empty after storage/AI/map migration.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
