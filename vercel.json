{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": "vite",
  "functions": {
    "api/download-flow-automation.ts": {
      "includeFiles": "server/assets/contents-view-flow-automation.zip"
    }
  },
  "rewrites": [
    {
      "source": "/news/issues/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|TelegramBot|KakaoTalk-Scrap|kakaotalk-scrap|naverbot|Googlebot|bingbot|Baiduspider|Yeti|Applebot).*"
        }
      ],
      "destination": "/api/issue-preview?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
